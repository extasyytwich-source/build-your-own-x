# Puerto en el que corre la API
PORT=4000

# Conexión a PostgreSQL. En producción (Render u otro proveedor) la da el
# proveedor de hosting; en desarrollo local, la de tu Postgres local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tienda_admin_dev

# Llave para firmar las sesiones (JWT). Cambia esto por un valor propio y
# secreto antes de usar la app con datos reales — cualquiera con esta llave
# podría fabricar sesiones válidas.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-secreto

# Origen permitido para CORS (la URL donde corre el cliente en desarrollo)
CLIENT_ORIGIN=http://localhost:5173

# Client ID de Google (console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID → Web application) para habilitar
# "Iniciar sesión con Google". Tiene que ser EL MISMO valor que
# VITE_GOOGLE_CLIENT_ID en client/.env — el servidor lo usa para confirmar
# que el token de Google es para esta app y no para otra. Sin esto, el botón
# de Google no funciona (el endpoint responde que no está configurado).
GOOGLE_CLIENT_ID=

# URL pública real del sitio (para armar los links de retorno/confirmación
# de pago que le pasamos a Flow, y para registrar el webhook de Telegram).
# En desarrollo local se puede dejar vacío para Flow (se arma sola a partir
# de la misma petición), pero el aviso de venta por Telegram sí la necesita
# configurada con la URL pública real (Telegram no puede llamar a localhost).
PUBLIC_URL=

# Token del bot de Telegram (@BotFather en Telegram → /newbot → te da un
# token como "123456789:AAüelValorReal") para que cada negocio pueda
# vincular un chat y recibir ahí un aviso —qué se vendió y cuánto se ganó—
# cada vez que se registra una venta desde Caja. Un solo bot sirve para
# todos los negocios de la app; sin esto, la sección "Avisos por Telegram"
# de Ajustes simplemente dice que no está configurado.
TELEGRAM_BOT_TOKEN=

# Credenciales de Flow (flow.cl) para el cobro de la suscripción mensual.
# Primero usa las de sandbox (pruebas con tarjetas de prueba); sin estas
# llaves configuradas, en desarrollo (NODE_ENV distinto de "production") la
# suscripción se activa directo para poder probar el resto del panel.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# API key de Anthropic (https://console.anthropic.com/) para habilitar el
# análisis mensual con IA en la sección de Reportes. Si se deja vacío, el
# resto del panel funciona igual, solo no se puede generar el análisis (cada
# negocio también puede pegar la suya propia desde Ajustes).
ANTHROPIC_API_KEY=

# API key de Resend (https://resend.com) para enviar el correo de "recuperar
# contraseña" del dueño. Sin esta llave, "¿Olvidaste tu contraseña?" sigue
# funcionando de punta a punta (genera el enlace y lo guarda), pero el
# correo no se envía de verdad — el enlace solo queda en el log del
# servidor, útil para probar en desarrollo. EMAIL_FROM es el remitente que
# verificaste en Resend (si se deja vacío, usa la casilla de pruebas de
# Resend, que solo entrega a tu propia cuenta).
RESEND_API_KEY=
EMAIL_FROM=Mostrador <onboarding@resend.dev>
